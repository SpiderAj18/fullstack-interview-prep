generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum AccountType {
  BANK
  CASH
  CREDIT_CARD
  DEBIT_CARD
  WALLET
  UPI
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NET_BANKING
  OTHER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  expenses     Expense[]
  incomes      Income[]
  transfers    Transfer[]
  categories   Category[]
  accounts     Account[]
  budgets      Budget[]
}

model Category {
  id         String       @id @default(cuid())
  name       String
  type       CategoryType
  color      String?
  icon       String?
  sortOrder  Int          @default(0)
  isSystem   Boolean      @default(false)
  archivedAt DateTime?
  userId     String
  parentId   String?
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]   @relation("CategoryTree")
  expenses   Expense[]
  incomes    Income[]
  budgetCategories BudgetCategory[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId, type, archivedAt])
  @@index([userId, parentId])
  @@index([userId, type, name])
}

model Account {
  id             String      @id @default(cuid())
  name           String
  type           AccountType
  currency       String      @default("INR")
  color          String?
  icon           String?
  sortOrder      Int         @default(0)
  openingBalance Decimal     @default(0) @db.Decimal(12, 2)
  currentBalance Decimal     @default(0) @db.Decimal(12, 2)
  isSystem       Boolean     @default(false)
  archivedAt     DateTime?
  userId         String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses         Expense[]
  incomes          Income[]
  transfersFrom    Transfer[]  @relation("TransferFromAccount")
  transfersTo      Transfer[]  @relation("TransferToAccount")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([userId, name])
  @@index([userId, archivedAt])
  @@index([userId, type])
}

model Expense {
  id              String         @id @default(cuid())
  amount          Decimal        @db.Decimal(12, 2)
  merchant        String?
  description     String?
  notes           String?
  paymentMethod   PaymentMethod?
  tags            String[]       @default([])
  transactionDate DateTime
  archivedAt      DateTime?
  userId          String
  accountId       String
  categoryId      String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, transactionDate])
  @@index([userId, accountId, transactionDate])
  @@index([userId, categoryId, transactionDate])
  @@index([userId, archivedAt])
}

model Income {
  id              String         @id @default(cuid())
  amount          Decimal        @db.Decimal(12, 2)
  source          String?
  description     String?
  notes           String?
  paymentMethod   PaymentMethod?
  tags            String[]       @default([])
  transactionDate DateTime
  archivedAt      DateTime?
  userId          String
  accountId       String
  categoryId      String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, transactionDate])
  @@index([userId, accountId, transactionDate])
  @@index([userId, categoryId, transactionDate])
  @@index([userId, archivedAt])
}

model Transfer {
  id              String   @id @default(cuid())
  amount          Decimal  @db.Decimal(12, 2)
  description     String?
  notes           String?
  transactionDate DateTime
  archivedAt      DateTime?
  userId          String
  fromAccountId   String
  toAccountId     String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount     Account  @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount       Account  @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, transactionDate])
  @@index([userId, fromAccountId, transactionDate])
  @@index([userId, toAccountId, transactionDate])
  @@index([userId, archivedAt])
}

enum BudgetAlertStatus {
  WARNING
  CRITICAL
  EXCEEDED
}

model Budget {
  id                 String           @id @default(cuid())
  year               Int
  month              Int
  totalLimit         Decimal          @db.Decimal(12, 2)
  currency           String           @default("INR")
  warningThreshold   Int              @default(80)
  criticalThreshold  Int              @default(90)
  archivedAt         DateTime?
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories         BudgetCategory[]
  alerts             BudgetAlert[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, year, month])
  @@index([userId, year, month])
  @@index([userId, archivedAt])
}

model BudgetCategory {
  id         String   @id @default(cuid())
  limitAmount Decimal @db.Decimal(12, 2)
  budgetId   String
  categoryId String
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([budgetId, categoryId])
  @@index([budgetId])
  @@index([categoryId])
}

model BudgetAlert {
  id          String            @id @default(cuid())
  threshold   Int
  status      BudgetAlertStatus
  scope       String
  message     String
  percentage  Decimal           @db.Decimal(7, 2)
  spent       Decimal           @db.Decimal(12, 2)
  limitAmount Decimal           @db.Decimal(12, 2)
  categoryId  String?
  acknowledgedAt DateTime?
  budgetId    String
  budget      Budget            @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([budgetId, scope, threshold])
  @@index([budgetId, acknowledgedAt])
}
